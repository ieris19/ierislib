<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.ieris19.config</groupId>
        <artifactId>ieris-origin</artifactId>
        <version>17.0.0</version>
    </parent>

    <artifactId>ierislib</artifactId>
    <groupId>com.ieris19.lib</groupId>
    <version>2.1.1</version>
    <packaging>pom</packaging>

    <modules>
        <module>commons</module>
        <module>utils</module>
        <module>games</module>
        <module>files</module>
        <module>ierisfx</module>
        <module>reflection</module>
        <module>economy</module>
        <module>net</module>
    </modules>

    <properties>
        <ieris.source.repoURL>https://github.com/Ieris19/IerisLib/tree/prime</ieris.source.repoURL>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.0-M1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Add source code and Javadoc to the JAR file -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.2.1</version>
                <configuration>
                    <attach>true</attach>
                    <goal>jar</goal>
                </configuration>
            </plugin>
<!--            <plugin>-->
<!--                <groupId>org.apache.maven.plugins</groupId>-->
<!--                <artifactId>maven-javadoc-plugin</artifactId>-->
<!--            </plugin>-->
        </plugins>
    </build>
    <reporting>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-project-info-reports-plugin</artifactId>
                <version>3.4.0</version>
            </plugin>
        </plugins>
    </reporting>

    <distributionManagement>
        <repository>
            <id>ierislib</id>
            <name>IerisLib</name>
            <!-- https://maven.pkg.github.com/ieris19/ierislib -->
            <url>file:///media/ieris19/development-drive/Development/Repositories/Maven</url>
        </repository>
    </distributionManagement>

    <repositories>
        <repository>
            <id>ieris-linux</id>
            <name>Ieris Local Repository</name>
            <url>file:///media/ieris19/development-drive/Development/Repositories/Maven</url>
        </repository>
        <repository>
            <id>ieris-windows</id>
            <name>Ieris Local Repository</name>
            <url>file:///D:/Development/Repositories/Maven</url>
        </repository>
        <repository>
            <id>maven_central</id>
            <name>Maven Central</name>
            <url>https://repo.maven.apache.org/maven2/</url>
        </repository>
        <repository>
            <id>ieris-github</id>
            <name>Ieris Repository</name>
            <url>https://maven.pkg.github.com/ieris19/*</url>
        </repository>
    </repositories>

    <name>IerisLib</name>
    <description>A library of reusable Java code to simplify the development of applications</description>
    <url>${ieris.source.repoURL}</url>
    <inceptionYear>2021</inceptionYear>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
            <comments>A business-friendly OSS license</comments>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>Ieris19</id>
            <name>Jason Abreu</name>
            <url>https://github.com/Ieris19/</url>
            <roles>
                <role>developer</role>
            </roles>
            <timezone>Europe/Copenhagen</timezone>
        </developer>
    </developers>
</project>